# Copy to `.env` (git-ignored). Placeholder words only — the owner supplies the dev-DB URL himself.
PORT=3001
# Required. No default: the process exits 1 with "DATABASE_URL is missing" without it (SPEC-002 AC-6).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/safe-goods_db
# Required by `bun test` only — a LOCAL Postgres database that the test run truncates.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/safe-goods_test
UPLOAD_DIR=uploads
JWT_SECRET=any-local-string
AUTO_RELEASE_SECONDS=259200
SWEEP_INTERVAL_MS=60000
CORS_ORIGIN=http://localhost:3000
# Seeded admin (`bun run seed`) — local placeholders, not secrets
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin1234
ADMIN_DISPLAY_NAME=Admin
